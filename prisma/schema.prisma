generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String               @id @default(uuid())
  name             String?
  email            String               @unique
  password         String?
  role             UserRole             @default(USER)
  avatar           String?
  createdAt        DateTime             @default(now())
  comments         Comment[]
  activities       Activity[]
  memberships      Membership[]
  projects         Project[]
  sessions         Session[]
  tasks            Task[]               @relation("AssignedTasks")
  todoLists        TodoList[]           @relation("TodoListOwner")
  todoMemberships  TodoListMembership[]
  createdTodoTasks TodoTask[]           @relation("TodoTaskCreator")
  todoMyDayEntries TodoMyDayEntry[]
  inboxList        TodoList?            @relation("TodoInboxOwner")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String       @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime     @default(now())
  ownerId     String
  members     Membership[]
  owner       User         @relation(fields: [ownerId], references: [id])
  sprints     Sprint[]
  tasks       Task[]
  activities  Activity[]
}

model Task {
  id          String      @id @default(uuid())
  title       String
  description String?
  issueType   IssueType   @default(TASK)
  status      TaskStatus  @default(TODO)
  priority    Priority    @default(MEDIUM)
  storyPoints Int?
  dueDate     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  projectId   String
  assigneeId  String?
  sprintId    String?
  comments    Comment[]
  assignee    User?       @relation("AssignedTasks", fields: [assigneeId], references: [id])
  project     Project     @relation(fields: [projectId], references: [id])
  sprint      Sprint?     @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  labels      TaskLabel[]
  activities  Activity[]
}

model Sprint {
  id        String    @id @default(uuid())
  title     String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model Activity {
  id        String       @id @default(uuid())
  type      ActivityType
  message   String
  createdAt DateTime     @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  taskId    String
  userId    String
  task      Task     @relation(fields: [taskId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Label {
  id    String      @id @default(uuid())
  name  String
  color String?
  tasks TaskLabel[]
}

model TaskLabel {
  taskId  String
  labelId String
  label   Label  @relation(fields: [labelId], references: [id])
  task    Task   @relation(fields: [taskId], references: [id])

  @@id([taskId, labelId])
}

model Membership {
  id        String  @id @default(uuid())
  role      Role    @default(MEMBER)
  userId    String
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([userId, projectId])
}

model TodoList {
  id           String               @id @default(uuid())
  name         String
  isInbox      Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  ownerId      String
  inboxOwnerId String?              @unique
  owner        User                 @relation("TodoListOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  inboxOwner   User?                @relation("TodoInboxOwner", fields: [inboxOwnerId], references: [id], onDelete: Cascade)
  memberships  TodoListMembership[]
  tasks        TodoTask[]

  @@index([ownerId])
}

model TodoListMembership {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  listId    String
  userId    String
  list      TodoList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([userId])
}

model TodoTask {
  id           String           @id @default(uuid())
  title        String
  note         String?
  isCompleted  Boolean          @default(false)
  important    Boolean          @default(false)
  dueDate      DateTime?
  reminderAt   DateTime?
  repeat       TodoRepeat?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  listId       String
  creatorId    String
  list         TodoList         @relation(fields: [listId], references: [id], onDelete: Cascade)
  creator      User             @relation("TodoTaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  steps        TodoTaskStep[]
  myDayEntries TodoMyDayEntry[]

  @@index([listId, dueDate])
  @@index([listId, isCompleted])
}

model TodoMyDayEntry {
  id        String   @id @default(uuid())
  date      DateTime
  createdAt DateTime @default(now())
  userId    String
  taskId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      TodoTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId, date])
  @@index([taskId])
}

model TodoTaskStep {
  id          String   @id @default(uuid())
  title       String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  taskId      String
  task        TodoTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum IssueType {
  EPIC
  STORY
  TASK
  BUG
}

enum Role {
  OWNER
  MEMBER
}

enum UserRole {
  USER
  ADMIN
}

enum TodoRepeat {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ActivityType {
  TASK_CREATED
  TASK_COMPLETED
  TASK_COMMENTED
  SPRINT_CREATED
}
