DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
PG_CONNECTION_TIMEOUT_MS=15000
PG_POOL_MAX=1

UPSTASH_REDIS_REST_URL="https://YOUR_UPSTASH_REDIS_URL"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REDIS_TOKEN"

# Optional: configure both values to bootstrap the first administrator.
ADMIN_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_TOKEN="generate-a-long-random-secret"
